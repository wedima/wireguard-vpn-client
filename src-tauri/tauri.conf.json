{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wedima VPN WG",
  "version": "0.1.6",
  "identifier": "com.wedima.vpn.wg",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Wedima VPN WG",
        "width": 420,
        "height": 580,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "wedima",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "wintun.dll": "wintun.dll"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3OTM4ODEwOTEzRUU2NzEKUldSeDVqNlJFSWlUVjB3b1g4WEcvTzJMOWJsTmtWcUtpZ0dBTnZ2MGtZc1V3aU1PY0Fnd2lwT2EK",
      "endpoints": [
        "https://github.com/wedima/wireguard-vpn-client/releases/latest/download/latest.json"
      ],
      "dangerousInsecureTransportProtocol": false,
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
